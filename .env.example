# Rent Comp Tracker — local development environment
# Copy this file to ".env" and fill in your values.
# .env is gitignored; never commit real credentials.
#
# In production (GitHub Actions), these come from repo Secrets — not this file.

# --- Email notifications via Resend -----------------------------------------

# Set to "true" to send daily digest emails. Anything else (or unset) skips.
NOTIFY_ENABLED=false

# API key from https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY=re_your_key_here

# Sender address. Until you verify a domain in Resend, this MUST be
# 'onboarding@resend.dev'. The display name (before <>) can be anything.
NOTIFY_FROM=Rent Comps <onboarding@resend.dev>

# Recipient(s), comma-separated for multiple.
# Until you verify a domain in Resend, the recipient MUST be the email address
# you used to sign up for Resend. After domain verification, any address.
NOTIFY_TO=youraddress@gmail.com

# Optional: link shown in the email body and the "View dashboard" button.
# Defaults to local file:// path. In production, point at GitHub Pages:
#   DASHBOARD_URL=https://YOUR-USERNAME.github.io/rent-comp-tracker/
# DASHBOARD_URL=
