# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local-only artifacts (regenerable / large / sensitive)
# NOTE: data/tracker.db and dashboard/index.html ARE tracked — the GitHub
# Actions workflow commits them on every run. Don't add them here.
data/raw/
data/exports/
data/cron.log

# Secrets — credentials live in GitHub Actions secrets, never in repo
.env

# Audit artifacts (regenerable, may contain diffs/prompts — never commit secrets)
artifacts/*
!artifacts/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
screenshots/
